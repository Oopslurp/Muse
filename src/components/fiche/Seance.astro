---
/**
 * Protocole de séance.
 *
 * CLAUDE.md, décision 3 : le signal d'arrêt s'affiche **près du tempo**,
 * dans le bloc de travail, jamais en bas de page. On le lit au moment où
 * l'on décide de pousser, pas après.
 *
 * Ce composant est donc placé au-dessus de la progression, pas en annexe.
 */
import StatusBadge from '~/components/ui/StatusBadge.astro';
import { statutAffiche, type Provenance } from '~/lib/provenance';
import { dureeSeance, duree, nomMoment } from '~/lib/format';
import Observer from '~/components/react/Observer';

interface Seance {
  moment: string[];
  dureeMin?: number | undefined;
  dureeMax: number;
  frequence: string;
  series?: { travailSecondes: number; reposSecondes: number; nombre: number } | undefined;
  signalArret: string[];
  reposMin: number;
  risque: 'faible' | 'modere' | 'eleve';
  avertissementSante?: string | undefined;
  provenance: Provenance;
}

interface Props {
  seance: Seance;
  /** Identifiant de la fiche, pour promouvoir le protocole séparément. */
  fiche: string;
}

const { seance: s, fiche } = Astro.props;

const RISQUE: Record<string, string> = {
  faible: 'Risque faible',
  modere: 'Risque modéré',
  eleve: 'Risque élevé',
};
---

<section class:list={['seance', `seance--${s.risque}`]} aria-labelledby="seance-titre">
  <header class="seance__head">
    <h2 id="seance-titre">Séance</h2>
    <div class="seance__meta">
      <span class:list={['risque', `risque--${s.risque}`]}>{RISQUE[s.risque]}</span>
      <StatusBadge status={statutAffiche(s.provenance)} />
    </div>
  </header>

  <dl class="cadre">
    <div>
      <dt>Durée</dt>
      <dd class="chiffre">{dureeSeance(s.dureeMin, s.dureeMax)}</dd>
    </div>
    <div>
      <dt>Fréquence</dt>
      <dd>{s.frequence}</dd>
    </div>
    <div>
      <dt>Repos minimal</dt>
      <dd class="chiffre">{duree(s.reposMin)}</dd>
    </div>
    <div>
      <dt>Placement</dt>
      <dd>{s.moment.map(nomMoment).join(' · ')}</dd>
    </div>
    {
      s.series && (
        <div class="cadre__large">
          <dt>En séries</dt>
          <dd>
            {s.series.nombre} × {duree(s.series.travailSecondes)} de travail,
            {' '}
            {duree(s.series.reposSecondes)} de repos complet — mains pendantes,
            pas «&nbsp;en attente&nbsp;».
          </dd>
        </div>
      )
    }
  </dl>

  <!-- Le bloc qui justifie tout le composant. -->
  <div class="arret">
    <p class="arret__titre">
      <svg viewBox="0 0 20 20" aria-hidden="true" class="arret__icone">
        <path
          d="M10 2.6 18.2 17H1.8L10 2.6Z"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linejoin="round"></path>
        <path d="M10 8v3.6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
        ></path>
        <circle cx="10" cy="14.4" r="0.95" fill="currentColor"></circle>
      </svg>
      Signaux d'arrêt
    </p>
    <ol class="arret__liste">
      {
        s.signalArret.map((sig, i) => (
          <li>
            <span class="arret__rang">{i === 0 ? 'alarme' : i + 1}</span>
            <span>{sig}</span>
          </li>
        ))
      }
    </ol>
    <p class="arret__note">
      Le premier signal est l'alarme utile&nbsp;: il arrive avant la douleur.
      S'arrêter là, pas au dernier.
    </p>
  </div>

  {s.avertissementSante && <p class="avert">{s.avertissementSante}</p>}

  {/* Les durées et les signaux d'arrêt des fiches percussives sont marqués
      déduits, faute de littérature. Les confirmer à l'usage est exactement
      ce que la promotion sert à enregistrer. */}
  <Observer client:visible fiche={fiche} element="seance" compact />
</section>

<style>
  .seance {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    padding: 1.35rem 1.45rem;
  }
  .seance--eleve {
    border-color: color-mix(in oklab, var(--c-sante) 35%, var(--color-line));
  }

  .seance__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.1rem;
  }
  .seance__head h2 {
    font-size: var(--text-h3);
    margin: 0;
  }
  .seance__meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .risque {
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-3);
  }
  .risque--modere {
    color: var(--color-verifier);
  }
  .risque--eleve {
    color: var(--color-sante);
  }

  .cadre {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(9.5rem, 100%), 1fr));
    gap: 1rem 1.4rem;
    margin: 0 0 1.25rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-line);
  }
  .cadre__large {
    grid-column: 1 / -1;
  }
  .cadre dt {
    font-size: var(--text-2xs);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-ink-3);
    margin-bottom: 0.2rem;
  }
  .cadre dd {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    line-height: 1.5;
  }
  .chiffre {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 48, 'WONK' 0;
    font-size: 1.3rem !important;
    font-weight: 600;
    color: var(--color-ink) !important;
    font-variant-numeric: tabular-nums lining-nums;
  }

  /* ---------------------------------------------------------------- arrêt */
  .arret {
    border-left: 3px solid var(--color-sante);
    background: var(--color-sante-bg);
    border-radius: 0 var(--radius-card) var(--radius-card) 0;
    padding: 0.9rem 1.05rem;
  }
  .arret__titre {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0 0.6rem;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-sante);
  }
  .arret__icone {
    width: 1.05rem;
    height: 1.05rem;
    flex: none;
  }
  .arret__liste {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
    counter-reset: none;
  }
  .arret__liste li {
    display: grid;
    grid-template-columns: 4.4rem 1fr;
    gap: 0.7rem;
    align-items: baseline;
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    line-height: 1.5;
  }
  .arret__rang {
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-sante);
    text-align: right;
  }
  .arret__note {
    margin: 0.7rem 0 0;
    font-size: var(--text-xs);
    font-style: italic;
    color: var(--color-ink-3);
  }

  .avert {
    margin: 1rem 0 0;
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--color-sante);
  }

  @media (max-width: 34rem) {
    .arret__liste li {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }
    .arret__rang {
      text-align: left;
    }
  }
</style>
