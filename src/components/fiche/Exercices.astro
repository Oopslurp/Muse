---
/**
 * Exercices.
 *
 * Chaque exercice avec tablature reçoit un lecteur alphaTab, hydraté à la
 * visibilité : une fiche peut en compter cinq, et chacun ouvre un contexte
 * audio. Les charger tous à l'ouverture de la page épuiserait la limite du
 * navigateur pour rien.
 *
 * La source alphaTex reste accessible sous la partition. Elle fait foi, elle
 * se copie dans le playground alphaTab, et elle reste lisible si le lecteur
 * ne démarre pas.
 *
 * CLAUDE.md, décision 10 : quand `audioFidele` est faux, on n'ampute rien —
 * on lit quand même et on nomme précisément ce que le rendu ne restitue pas.
 */
import StatusBadge from '~/components/ui/StatusBadge.astro';
import LecteurTab from '~/components/react/LecteurTab';
import { statutAffiche, type Provenance } from '~/lib/provenance';
import { plageTempo, nomOrigineExercice, type Tempo } from '~/lib/format';
import Observer from '~/components/react/Observer';

/** Le lecteur raisonne en pulsations par minute ; les tempos en notes par
 *  minute ne s'y traduisent pas et sont donc ignorés. */
const bpm = (t: Tempo | undefined): number | undefined =>
  t && t.unite === 'bpm' ? t.valeur : undefined;

interface Exercice {
  id: string;
  titre: string;
  description: string;
  origine: string;
  alphaTex?: string | undefined;
  tempoDepart?: Tempo | undefined;
  tempoCible?: Tempo | undefined;
  audioFidele: boolean;
  reservesAudio: string[];
  provenance?: Provenance | undefined;
}

interface Props {
  exercices: Exercice[];
  /** Identifiant de la fiche, pour promouvoir chaque exercice séparément. */
  fiche: string;
}

const { exercices, fiche } = Astro.props;
---

<div class="exos">
  {
    exercices.map((e) => {
      const plage = plageTempo(e.tempoDepart, e.tempoCible);
      return (
        <article class="exo" id={`ex-${e.id}`}>
          <header class="exo__tete">
            <h3 class="exo__titre">{e.titre}</h3>
            <div class="exo__meta">
              {plage && <span class="tempo">{plage}</span>}
              <span class="origine">{nomOrigineExercice(e.origine)}</span>
              {e.provenance && <StatusBadge status={statutAffiche(e.provenance)} />}
            </div>
          </header>

          <p class="exo__desc">{e.description}</p>

          {e.provenance?.doute && (
            <p class="exo__doute">
              <span class="exo__doute-k">À vérifier</span>
              {e.provenance.doute}
            </p>
          )}

          {e.alphaTex && (
            <div class="tab">
              <LecteurTab
                client:visible
                alphaTex={e.alphaTex}
                tempoDepart={bpm(e.tempoDepart)}
                tempoCible={bpm(e.tempoCible)}
                reservesAudio={e.audioFidele ? [] : e.reservesAudio}
              />
              <details class="source">
                <summary>
                  <span class="source__format">alphaTex</span>
                  <span class="source__hint">la source fait foi</span>
                </summary>
                <pre><code>{e.alphaTex.trim()}</code></pre>
              </details>
            </div>
          )}

          <Observer client:visible fiche={fiche} element={`exercice:${e.id}`} compact />
        </article>
      );
    })
  }
</div>

<style>
  .exos {
    display: grid;
    gap: 1.5rem;
  }

  .exo {
    scroll-margin-top: 6rem;
    /* Voir la note sur min-width dans [id].astro : enfant de grille. */
    min-width: 0;
  }

  .exo__tete {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin-bottom: 0.4rem;
  }
  .exo__titre {
    font-size: var(--text-lg);
    margin: 0;
  }
  .exo__meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tempo {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    color: var(--color-ink-2);
    white-space: nowrap;
  }
  /* Sous 22rem, le libellé complet ne tient plus sur une ligne et un élément
     en `nowrap` fixe la largeur minimale de tout ce qui le contient. */
  @media (max-width: 22rem) {
    .tempo {
      white-space: normal;
    }
  }
  .origine {
    font-size: var(--text-2xs);
    color: var(--color-ink-3);
  }

  .exo__desc {
    margin: 0 0 0.85rem;
    font-size: var(--text-sm);
    line-height: 1.62;
    color: var(--color-ink-2);
    max-width: 68ch;
  }

  .exo__doute {
    margin: 0 0 0.85rem;
    padding: 0.6rem 0.85rem;
    border-left: 2px solid var(--color-verifier);
    background: color-mix(in oklab, var(--c-verifier) 6%, transparent);
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--color-ink-2);
  }
  .exo__doute-k {
    display: inline-block;
    margin-right: 0.55em;
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-verifier);
  }

  /* ------------------------------------------------------------ tablature */
  .tab {
    min-width: 0;
  }

  /* La source alphaTex, repliée. Elle reste la référence — c'est elle qu'on
     copie dans le playground et elle qui subsiste si le lecteur échoue. */
  .source {
    margin-top: 0.45rem;
  }
  .source summary {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    cursor: pointer;
    list-style: none;
    padding: 0.15rem 0;
  }
  .source summary::-webkit-details-marker {
    display: none;
  }
  .source summary::before {
    content: '▸';
    font-size: 0.7em;
    color: var(--color-ink-3);
    transition: transform 160ms ease;
  }
  .source[open] summary::before {
    transform: rotate(90deg);
  }
  .source__format {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    letter-spacing: 0.06em;
    color: var(--color-ink-2);
  }
  .source__hint {
    font-size: var(--text-2xs);
    font-style: italic;
    color: var(--color-ink-3);
  }

  .source pre {
    margin: 0.4rem 0 0;
    padding: 0.9rem 1rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-surface-2);
    overflow-x: auto;
    font-size: 0.82rem;
    line-height: 1.65;
    color: var(--color-ink-2);
  }
</style>
