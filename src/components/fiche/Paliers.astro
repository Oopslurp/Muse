---
/**
 * Progression par paliers.
 *
 * Le critère de passage est la colonne qui compte : c'est lui qui remplace le
 * professeur. Le schéma refuse « quand tu te sens prêt » ; quand un critère
 * n'est pas vérifiable seul, la fiche le dit au lieu de faire semblant.
 */
import { plageTempo, tempoLong, type Tempo } from '~/lib/format';

interface Palier {
  titre: string;
  objectif: string;
  exercices: string[];
  tempoDepart?: Tempo | undefined;
  tempoCible?: Tempo | undefined;
  critere: string;
  autoVerifiable: boolean;
  note?: string | undefined;
}

interface Props {
  paliers: Palier[];
  /** Pour rendre le titre des exercices référencés. */
  titresExercices: Record<string, string>;
}

const { paliers, titresExercices } = Astro.props;
---

<ol class="paliers">
  {
    paliers.map((p, i) => {
      const plage = plageTempo(p.tempoDepart, p.tempoCible);
      const infobulle = [p.tempoDepart, p.tempoCible]
        .filter(Boolean)
        .map((t) => tempoLong(t as Tempo))
        .join(' → ');
      return (
        <li class="palier">
          <div class="palier__rang" aria-hidden="true">
            P{i + 1}
          </div>

          <div class="palier__corps">
            <h3 class="palier__titre">{p.titre}</h3>
            <p class="palier__objectif">{p.objectif}</p>

            <div class="palier__bandeau">
              {plage && (
                <span class="tempo" title={infobulle}>
                  {plage}
                </span>
              )}
              {p.exercices.map((id) => (
                <a href={`#ex-${id}`} class="lien-ex">
                  {titresExercices[id] ?? id}
                </a>
              ))}
            </div>

            <div class="critere">
              <p class="critere__k">
                Critère de passage
                {!p.autoVerifiable && (
                  <span class="critere__aide" title="Ce critère demande un retour extérieur">
                    non vérifiable seul
                  </span>
                )}
              </p>
              <p class="critere__v">{p.critere}</p>
            </div>

            {p.note && <p class="palier__note">{p.note}</p>}
          </div>
        </li>
      );
    })
  }
</ol>

<style>
  .paliers {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }

  .palier {
    display: grid;
    grid-template-columns: 3.2rem 1fr;
    gap: 1.2rem;
    padding: 1.35rem 0;
    border-top: 1px solid var(--color-line);
  }
  .palier:last-child {
    border-bottom: 1px solid var(--color-line);
  }

  .palier__rang {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 48, 'SOFT' 20, 'WONK' 0;
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-brass);
    font-variant-numeric: tabular-nums lining-nums;
    padding-top: 0.1rem;
  }

  .palier__titre {
    font-size: var(--text-h3);
    margin: 0 0 0.25rem;
  }
  .palier__objectif {
    margin: 0 0 0.75rem;
    color: var(--color-ink-2);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .palier__bandeau {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.85rem;
  }

  /* Le tempo, en chiffres tabulaires : les paliers se comparent en colonne. */
  .tempo {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    background: var(--color-surface-2);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    padding: 0.28em 0.7em;
    color: var(--color-ink);
    white-space: nowrap;
  }

  .lien-ex {
    font-size: var(--text-xs);
    color: var(--color-brass);
    text-decoration: none;
    border-bottom: 1px dotted currentColor;
  }
  .lien-ex:hover {
    color: var(--color-ink);
  }

  .critere {
    border-left: 2px solid var(--color-brass-bright);
    padding-left: 0.9rem;
  }
  .critere__k {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex-wrap: wrap;
    margin: 0 0 0.2rem;
    font-size: var(--text-2xs);
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-ink-3);
  }
  .critere__aide {
    text-transform: none;
    letter-spacing: 0;
    font-weight: 600;
    color: var(--color-verifier);
    border: 1px dashed color-mix(in oklab, var(--c-verifier) 45%, transparent);
    border-radius: var(--radius-pill);
    padding: 0.1em 0.5em;
  }
  .critere__v {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .palier__note {
    margin: 0.75rem 0 0;
    font-size: var(--text-xs);
    font-style: italic;
    color: var(--color-ink-3);
  }

  @media (max-width: 34rem) {
    .palier {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
  }
</style>
