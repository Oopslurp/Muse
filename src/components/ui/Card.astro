---
/**
 * Carte. Rend un <a> si `href` est fourni, un <article> sinon.
 *
 * L'effet de survol reste minimal — une carte qui décolle de 8 px et change
 * d'ombre appartient au registre SaaS. Ici : un filet d'accent qui s'affirme
 * et un très léger soulèvement, désactivés si l'utilisateur refuse le
 * mouvement.
 */
interface Props {
  href?: string | undefined;
  /** Variable CSS d'accent, ex. `--c-md`. */
  colorVar?: string | undefined;
  /** Grise la carte et neutralise le lien — pour ce qui n'existe pas encore. */
  muted?: boolean;
  class?: string | undefined;
}

const { href, colorVar, muted = false, class: className = '' } = Astro.props;
const accent = colorVar ? `var(${colorVar})` : 'var(--c-brass-bright)';
const Tag = href && !muted ? 'a' : 'article';
---

<Tag
  {...href && !muted ? { href } : {}}
  class:list={['card', muted && 'card--muted', href && !muted && 'card--link', className]}
  style={`--accent:${accent}`}
>
  <span class="card__edge" aria-hidden="true"></span>
  <slot />
</Tag>

<style>
  .card {
    position: relative;
    display: block;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    padding: 1.35rem 1.45rem;
    box-shadow: var(--shadow-card);
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    transition:
      transform 220ms cubic-bezier(0.2, 0.7, 0.3, 1),
      box-shadow 220ms ease,
      border-color 220ms ease;
  }

  /* Filet d'accent sur le bord gauche — la « tranche » de la fiche. */
  .card__edge {
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: var(--accent);
    opacity: 0.55;
    transition: opacity 220ms ease;
  }

  .card--link:hover,
  .card--link:focus-visible {
    transform: translateY(-2px);
    box-shadow: var(--shadow-lift);
    border-color: color-mix(in oklab, var(--accent) 40%, var(--color-line));
  }

  .card--link:hover .card__edge,
  .card--link:focus-visible .card__edge {
    opacity: 1;
  }

  .card--muted {
    opacity: 0.62;
    box-shadow: none;
    background: transparent;
    border-style: dashed;
  }
  .card--muted .card__edge {
    opacity: 0.25;
  }

  @media (prefers-reduced-motion: reduce) {
    .card--link:hover,
    .card--link:focus-visible {
      transform: none;
    }
  }
</style>
