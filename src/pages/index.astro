---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Card from '~/components/ui/Card.astro';
import Badge from '~/components/ui/Badge.astro';
import StatusBadge from '~/components/ui/StatusBadge.astro';
import Difficulty from '~/components/ui/Difficulty.astro';
import Callout from '~/components/ui/Callout.astro';
import Button from '~/components/ui/Button.astro';
import { FAMILIES, STATUSES } from '~/lib/taxonomy';
import { corpus } from '~/lib/corpus';
import { TRANCHES } from '~/lib/nav';

const done = TRANCHES.filter((t) => t.done).length;
const c = await corpus();
---

<BaseLayout title="Muse">
  <!-- ================================================================== -->
  <!-- Ouverture                                                          -->
  <!-- ================================================================== -->
  <section class="hero">
    <div class="hero__text">
      <p class="eyebrow">Guitare fingerstyle · classique · percussive</p>
      <h1 class="hero__title">
        Trente-trois gestes,<br />
        et ce qu'on sait <em>vraiment</em><br />
        de chacun.
      </h1>
      <p class="hero__lede">
        Une bibliothèque de technique construite à l'envers des autres&nbsp;: chaque
        geste y est un objet durable, avec ses prérequis, ses erreurs typiques et la
        façon de les repérer seul — et, pour les plus structurantes, une progression
        par paliers. Chaque affirmation dit d'où elle vient.
      </p>

      <div class="hero__actions">
        <Button href="/techniques" variant="primary">
          Parcourir les {c.fiches} fiches
        </Button>
        <Button href="/style-guide" variant="secondary">Voir le design system</Button>
      </div>

      <dl class="specs">
        <div>
          <dt>Techniques</dt>
          <dd>{c.techniques}</dd>
        </div>
        <div>
          <dt>Fiches approfondies</dt>
          <dd>{c.completes}</dd>
        </div>
        <div>
          <dt>Fiches</dt>
          <dd>{c.fiches}</dd>
        </div>
        <div>
          <dt>Tranches livrées</dt>
          <dd>{done}<span class="specs__of">/{TRANCHES.length}</span></dd>
        </div>
      </dl>
    </div>

    <!-- Spécimen : une vraie entrée du corpus, pour montrer plutôt que décrire. -->
    <aside class="specimen" aria-label="Exemple de fiche technique">
      <Card colorVar="--c-md" class="specimen__card">
        <div class="specimen__top">
          <Badge colorVar="--c-md" size="sm">MD-08 · Main droite</Badge>
          <Difficulty value={5} colorVar="--c-md" size="md" />
        </div>

        <h2 class="specimen__title">Trémolo</h2>
        <p class="specimen__names">
          <span lang="en">tremolo</span> · <span lang="es">trémolo</span>
        </p>

        <p class="specimen__sound">
          Une seule note tenue, pas quatre notes rapides. Si l'auditeur peut
          compter les notes, ce n'est pas encore du trémolo.
        </p>

        <div class="specimen__rows">
          <div class="row">
            <span class="row__k">Prérequis</span>
            <span class="row__v">Pincé · Arpèges p-i-m-a · Appui préparé</span>
          </div>
          <div class="row">
            <span class="row__k">Palier 2</span>
            <span class="row__v">
              Égalité en doubles-croches · ♩ 40 → 60
              <span class="row__crit">
                Métronome sur la 2ᵉ note du cycle, tenir 8 mesures.
              </span>
            </span>
          </div>
          <div class="row row--sante">
            <span class="row__k">Arrêt</span>
            <span class="row__v">
              Réapparition du galop <span class="row__sep" aria-hidden="true">·</span> tension au dos
              de la main <span class="row__sep" aria-hidden="true">·</span> 10 min maximum
            </span>
          </div>
        </div>

        <div class="specimen__foot">
          <StatusBadge status="source" />
          <span class="specimen__src">Tennant · Giuliani op. 1 · Carlevaro</span>
        </div>
      </Card>
      <p class="specimen__caption">
        Extrait d'une fiche réelle, à sa mise en page réelle.
      </p>
    </aside>
  </section>

  <!-- ================================================================== -->
  <!-- Le principe                                                        -->
  <!-- ================================================================== -->
  <section class="section" aria-labelledby="principe">
    <header class="section__head">
      <p class="eyebrow">Le principe</p>
      <h2 id="principe" class="section__title">Chaque affirmation dit d'où elle vient</h2>
      <p class="section__lede">
        La littérature sur la guitare mélange sans le signaler ce qui est établi,
        ce qui est déduit et ce qui est répété de bouche à oreille. Ici les trois
        états sont séparés et affichés. Un doute visible vaut mieux qu'une
        affirmation lisse.
      </p>
    </header>

    <div class="grid grid--3">
      {
        STATUSES.map((s) => (
          <Card colorVar={s.colorVar}>
            <StatusBadge status={s.id} size="md" />
            <p class="status__meaning">{s.meaning}</p>
          </Card>
        ))
      }
    </div>
  </section>

  <!-- ================================================================== -->
  <!-- Familles                                                           -->
  <!-- ================================================================== -->
  <section class="section" aria-labelledby="familles">
    <header class="section__head">
      <p class="eyebrow">La carte</p>
      <h2 id="familles" class="section__title">Quatre familles, un graphe</h2>
      <p class="section__lede">
        Les techniques ne sont pas une liste&nbsp;: elles se conditionnent. L'appui
        préparé commande à la fois les arpèges et le trémolo&nbsp;; les
        étouffements commandent tout le percussif. Le graphe de prérequis rend ces
        dépendances navigables.
      </p>
    </header>

    <div class="grid grid--2">
      {
        FAMILIES.map((f) => (
          <Card colorVar={f.colorVar} href={`/techniques?famille=${f.id}`}>
            <div class="fam__top">
              <Badge colorVar={f.colorVar} size="sm" variant="solid">
                {f.code}
              </Badge>
              <span class="fam__count">{c.parFamille[f.id]} fiches</span>
            </div>
            <h3 class="fam__title">{f.label}</h3>
            <p class="fam__blurb">{f.blurb}</p>
          </Card>
        ))
      }
    </div>
  </section>

  <!-- ================================================================== -->
  <!-- Santé                                                              -->
  <!-- ================================================================== -->
  <section class="section section--narrow" aria-labelledby="sante">
    <header class="section__head">
      <p class="eyebrow">Ce qui a changé la conception</p>
      <h2 id="sante" class="section__title">Savoir quand s'arrêter</h2>
    </header>

    <Callout tone="sante" title="Pourquoi chaque fiche porte un signal d'arrêt">
      <p>
        Jusqu'à <strong>89&nbsp;% des musiciens</strong> rapportent une blessure
        professionnelle au cours de leur carrière, et la douleur poignet-main est
        la plus fréquente. Dans un centre de médecine des arts du spectacle,
        <strong>42&nbsp;% des musiciens atteints de dystonie focale étaient des
        guitaristes</strong>.
      </p>
      <p>
        Le fait décisif est le troisième&nbsp;: <strong>les premiers signes sont
        typiquement pris pour un défaut de technique</strong>. Le musicien en
        conclut qu'il doit travailler davantage — et aggrave.
      </p>
      <p>
        Un site qui n'affiche que des objectifs et jamais de limite est donc
        activement contre-productif. Ici, chaque technique porte une durée
        maximale et des signaux d'arrêt nommés, affichés à côté du tempo et non
        en bas de page.
      </p>
      {/* Le corollaire dû au lecteur, au plus près des chiffres. Ces
          statistiques décrivent des populations ; plusieurs durées maximales
          sont des déductions prudentes faute de littérature. */}
      <p class="sante__reserve">
        Ces chiffres décrivent des populations, pas votre main, et une partie des
        valeurs proposées ici sont des déductions prudentes plutôt que des seuils
        mesurés. <strong>Ce site n'est pas un avis médical</strong> —
        <a href="/a-propos">ce qu'il est et ce qu'il n'est pas</a>.
      </p>
    </Callout>
  </section>

  <!-- ================================================================== -->
  <!-- Chantier                                                           -->
  <!-- ================================================================== -->
  <section class="section" aria-labelledby="chantier">
    <header class="section__head">
      <p class="eyebrow">État du chantier</p>
      <h2 id="chantier" class="section__title">Ce qui existe, ce qui vient</h2>
      <p class="section__lede">
        Le site se construit par tranches. Rien n'est masqué&nbsp;: ce qui n'est
        pas fait est listé comme tel.
      </p>
    </header>

    <ol class="tranches">
      {
        TRANCHES.map((t) => (
          <li class:list={['tranche', t.done && 'tranche--done']}>
            <span class="tranche__n" aria-hidden="true">
              {t.n}
            </span>
            <div class="tranche__body">
              <p class="tranche__label">
                {t.label}
                {t.done && (
                  <span class="tranche__flag">
                    <span class="sr-only">livrée</span>
                    <svg viewBox="0 0 16 16" aria-hidden="true">
                      <path
                        d="M3 8.4 6.2 11.6 13 4.8"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </span>
                )}
              </p>
              <p class="tranche__detail">{t.detail}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>

<style>
  /* ---------------------------------------------------------------- hero */
  .hero {
    display: grid;
    grid-template-columns: 1.12fr 0.88fr;
    gap: clamp(2rem, 1rem + 4vw, 4.5rem);
    align-items: start;
    padding: clamp(3rem, 2rem + 5vw, 6.5rem) 0 var(--spacing-section);
  }

  .hero__title {
    font-size: var(--text-display);
    line-height: 1.02;
    font-weight: 600;
    margin: 0.55rem 0 1.35rem;
    font-variation-settings: 'opsz' 144, 'SOFT' 18, 'WONK' 1;
  }

  /* Emphase en titrage : Fraunces n'est chargée qu'en romain (voir global.css).
     On la marque par la couleur, un dessin plus doux et un soulignement de
     laiton, plutôt que par une italique qui serait ici synthétisée. */
  .hero__title em {
    font-style: normal;
    color: var(--color-brass);
    font-variation-settings: 'opsz' 144, 'SOFT' 100, 'WONK' 1;
    background-image: linear-gradient(
      var(--color-brass-bright),
      var(--color-brass-bright)
    );
    background-repeat: no-repeat;
    background-size: 100% 2px;
    background-position: 0 92%;
    padding-bottom: 0.04em;
  }

  .hero__lede {
    max-width: 46ch;
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--color-ink-2);
    margin: 0 0 2rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-bottom: 2.75rem;
  }

  .specs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
    margin: 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line);
  }
  .specs div {
    min-width: 0;
  }
  .specs dt {
    font-size: var(--text-2xs);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-ink-3);
    margin-bottom: 0.25rem;
  }
  .specs dd {
    margin: 0;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 60, 'SOFT' 20, 'WONK' 0;
    font-size: 1.85rem;
    font-weight: 600;
    line-height: 1;
    /* Chiffres alignés : les colonnes doivent se lire comme un tableau. */
    font-variant-numeric: tabular-nums lining-nums;
  }
  .specs__of {
    font-size: 0.55em;
    color: var(--color-ink-3);
  }

  /* ------------------------------------------------------------ spécimen */
  .specimen {
    position: sticky;
    top: 6rem;
  }

  .specimen__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.9rem;
  }

  .specimen__title {
    font-size: var(--text-h2);
    line-height: 1.1;
    margin: 0;
  }

  .specimen__names {
    margin: 0.15rem 0 0.9rem;
    font-size: var(--text-xs);
    font-style: italic;
    color: var(--color-ink-3);
  }

  .specimen__sound {
    margin: 0 0 1.15rem;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-ink-2);
    border-left: 2px solid var(--color-brass-bright);
    padding-left: 0.85rem;
  }

  .specimen__rows {
    display: grid;
    gap: 0.7rem;
    font-size: var(--text-xs);
  }
  .row {
    display: grid;
    grid-template-columns: 5.2rem 1fr;
    gap: 0.75rem;
    align-items: baseline;
  }
  .row__k {
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-size: 0.9em;
    color: var(--color-ink-3);
  }
  .row__v {
    color: var(--color-ink-2);
    line-height: 1.5;
  }
  .row__crit {
    display: block;
    margin-top: 0.2rem;
    color: var(--color-ink-3);
    font-style: italic;
  }
  .row__sep {
    color: var(--color-ink-3);
    padding: 0 0.15em;
  }
  /* Le signal d'arrêt vit à côté du tempo, jamais en bas de page. */
  .row--sante .row__k,
  .row--sante .row__v {
    color: var(--color-sante);
  }

  .specimen__foot {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex-wrap: wrap;
    margin-top: 1.25rem;
    padding-top: 0.95rem;
    border-top: 1px solid var(--color-line);
  }
  .specimen__src {
    font-size: var(--text-2xs);
    color: var(--color-ink-3);
  }

  .specimen__caption {
    margin: 0.85rem 0 0;
    font-size: var(--text-2xs);
    color: var(--color-ink-3);
    text-align: right;
    font-style: italic;
  }

  /* ------------------------------------------------------------ sections */
  .section {
    padding-bottom: var(--spacing-section);
  }
  .section--narrow {
    max-width: 54rem;
  }

  .section__head {
    margin-bottom: 2rem;
    max-width: 58ch;
  }
  .section__title {
    font-size: var(--text-h1);
    line-height: 1.08;
    margin: 0.5rem 0 0;
  }
  .section__lede {
    margin: 1rem 0 0;
    font-size: var(--text-base);
    color: var(--color-ink-2);
    line-height: 1.65;
  }

  .grid {
    display: grid;
    gap: 1rem;
  }
  .grid--2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .grid--3 {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .status__meaning {
    margin: 0.75rem 0 0;
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--color-ink-2);
  }

  /* ------------------------------------------------------------ familles */
  .fam__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }
  .fam__count {
    font-size: var(--text-2xs);
    color: var(--color-ink-3);
    font-variant-numeric: tabular-nums;
  }
  .fam__title {
    font-size: var(--text-h3);
    margin: 0 0 0.4rem;
  }
  .fam__blurb {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--color-ink-2);
  }

  /* La réserve se lit avec les chiffres, sans leur voler la vedette : c'est
     une mise au point, pas le message. */
  .sante__reserve {
    margin: 1.1rem 0 0;
    padding-top: 0.9rem;
    border-top: 1px solid var(--color-line);
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-ink-3);
  }
  .sante__reserve strong {
    color: var(--color-ink-2);
  }

  /* ------------------------------------------------------------ tranches */
  .tranches {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
  }
  .tranche {
    display: grid;
    grid-template-columns: 2.6rem 1fr;
    gap: 1.1rem;
    align-items: baseline;
    padding: 1rem 0.25rem;
    border-bottom: 1px solid var(--color-line);
    opacity: 0.55;
  }
  .tranche--done {
    opacity: 1;
  }
  .tranche__n {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 48, 'WONK' 0;
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--color-ink-3);
    font-variant-numeric: tabular-nums lining-nums;
  }
  .tranche--done .tranche__n {
    color: var(--color-brass);
  }
  .tranche__label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-weight: 650;
    font-size: var(--text-base);
  }
  .tranche__flag {
    display: inline-grid;
    place-items: center;
    width: 1.05rem;
    height: 1.05rem;
    color: var(--color-observe);
  }
  .tranche__flag svg {
    width: 100%;
    height: 100%;
  }
  .tranche__detail {
    margin: 0.25rem 0 0;
    font-size: var(--text-sm);
    color: var(--color-ink-3);
    line-height: 1.55;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ---------------------------------------------------------- responsive */
  @media (max-width: 68rem) {
    .grid--3 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 60rem) {
    .hero {
      grid-template-columns: 1fr;
    }
    .specimen {
      position: static;
      max-width: 34rem;
    }
    .specimen__caption {
      text-align: left;
    }
  }

  @media (max-width: 42rem) {
    .grid--2,
    .grid--3 {
      grid-template-columns: 1fr;
    }
    .specs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.1rem;
    }
    .row {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }
</style>
